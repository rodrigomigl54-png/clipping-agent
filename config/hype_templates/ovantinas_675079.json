 "text": [
  {
   "type": "line",
   "t0": 0,
   "t1": 0.6,
   "text": "My"
  },
  {
   "type": "line",
   "t0": 0.6,
   "t1": 2,
   "text": "My Name Is Niko Bellic"
  },
  {
   "type": "line",
   "t0": 2,
   "t1": 2.7,
   "text": "I"
  },
  {
   "type": "line",
   "t0": 2.7,
   "t1": 4.7,
   "text": "I Was Born In Yugoslavia"
  },
  {
   "type": "line",
   "t0": 4.7,
   "t1": 5.6,
   "text": "I Was Born In Yugoslavia And Grew Up"
  },
  {
   "type": "line",
   "t0": 5.6,
   "t1": 6.6,
   "text": "I Was Born In Yugoslavia And Grew Up Surrounded By War"
  },
  {
   "type": "line",
   "t0": 6.6,
   "t1": 7.6,
   "text": "I"
  },
  {
   "type": "line",
   "t0": 7.6,
   "t1": 8.6,
   "text": "I Watched People Die"
  },
  {
   "type": "line",
   "t0": 8.6,
   "t1": 9.5,
   "text": "I Watched People Die I"
  },
  {
   "type": "line",
   "t0": 9.5,
   "t1": 10.4,
   "text": "I Watched People Die I Watched Friends"
  },
  {
   "type": "line",
   "t0": 10.4,
   "t1": 11.4,
   "text": "I Watched People Die I Watched Friends Become Enemies"
  },
  {
   "type": "line",
   "t0": 11.4,
   "t1": 12.4,
   "text": "I Was"
  },
  {
   "type": "line",
   "t0": 12.4,
   "t1": 13.4,
   "text": "I Was Betrayed By People"
  },
  {
   "type": "line",
   "t0": 13.4,
   "t1": 15,
   "text": "I Was Betrayed By People I Trusted"
  },
  {
   "type": "line",
   "t0": 15,
   "t1": 15.8,
   "text": "And Lost"
  },
  {
   "type": "line",
   "t0": 15.8,
   "t1": 16.7,
   "text": "And Lost People I"
  },
  {
   "type": "line",
   "t0": 16.7,
   "t1": 17.8,
   "text": "And Lost People I Never Should Have Lost"
  },
  {
   "type": "line",
   "t0": 17.8,
   "t1": 18.5,
   "text": "For"
  },
  {
   "type": "line",
   "t0": 18.5,
   "t1": 19.3,
   "text": "For Years"
  },
  {
   "type": "line",
   "t0": 19.3,
   "t1": 20.833,
   "text": "For Years I Tried"
  },
  {
   "type": "line",
   "t0": 20.833,
   "t1": 21.733,
   "text": "For Years I Tried To Leave That Life"
  },
  {
   "type": "line",
   "t0": 21.733,
   "t1": 22.8,
   "text": "For Years I Tried To Leave That Life Behind"
  },
  {
   "type": "line",
   "t0": 22.8,
   "t1": 23.6,
   "text": "Until I"
  },
  {
   "type": "line",
   "t0": 23.6,
   "t1": 24.7,
   "text": "Until I Crossed The Ocean"
  },
  {
   "type": "line",
   "t0": 24.7,
   "t1": 25.567,
   "text": "Searching"
  },
  {
   "type": "line",
   "t0": 25.567,
   "t1": 26.8,
   "text": "Searching For Something Better"
  },
  {
   "type": "line",
   "t0": 26.8,
   "t1": 27.6,
   "text": "Liberty City"
  },
  {
   "type": "line",
   "t0": 27.6,
   "t1": 28.5,
   "text": "Liberty City Was"
  },
  {
   "type": "line",
   "t0": 28.5,
   "t1": 29.433,
   "text": "Liberty City Was Supposed To Be A New"
  },
  {
   "type": "line",
   "t0": 29.433,
   "t1": 30.7,
   "text": "Liberty City Was Supposed To Be A New Beginning"
  },
  {
   "type": "line",
   "t0": 30.7,
   "t1": 31.6,
   "text": "But Some Things"
  },
  {
   "type": "line",
   "t0": 31.6,
   "t1": 33.633,
   "text": "But Some Things Cannot Be Left Behind"
  },
  {
   "type": "line",
   "t0": 33.633,
   "t1": 34.6,
   "text": "Some Mistakes"
  },
  {
   "type": "line",
   "t0": 34.6,
   "t1": 35.3,
   "text": "Some"
  },
  {
   "type": "line",
   "t0": 35.3,
   "t1": 36.3,
   "text": "Some Memories"
  },
  {
   "type": "line",
   "t0": 36.3,
   "t1": 37.467,
   "text": "Some Memories And Some Ghosts"
  },
  {
   "type": "line",
   "t0": 37.467,
   "t1": 38.667,
   "text": "Some Memories And Some Ghosts Never"
  },
  {
   "type": "line",
   "t0": 38.667,
   "t1": 39.833,
   "text": "Some Memories And Some Ghosts Never Stay Behind"
  }
 ],
